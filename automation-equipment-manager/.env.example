MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=aem
MYSQL_USER=aem_user
MYSQL_PASSWORD=change_me_mysql_password

DATABASE_URL=mysql+pymysql://aem_user:change_me_mysql_password@mysql:3306/aem?charset=utf8mb4

ALLOWED_ORIGINS=http://your-server-ip
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=系统管理员
AEM_TOKEN_SECRET=change_me_to_a_long_random_secret

# Docker 服务器部署时保持为空，前端会请求同域 /api，由 Nginx 转发到后端。
VITE_API_BASE_URL=
